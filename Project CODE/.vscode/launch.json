{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch in Chrome (F5)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Start CricPulse Dev Server"
    },
    {
      "name": "Launch in Edge (F5)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Start CricPulse Dev Server"
    }
  ]
}
